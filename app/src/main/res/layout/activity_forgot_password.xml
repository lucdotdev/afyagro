<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:scrollbars="none"
    android:background="@android:color/white"
    tools:context=".ui.first.ForgotPasswordActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="26dp"
        android:paddingRight="24dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="40dp"
            android:src="@drawable/logo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textStyle="bold"
            android:text="@string/forgot_title"
            android:textColor="#3c4b5d"
            android:textSize="22sp" />

        <!-- Étape 1 : numéro de téléphone -->
        <LinearLayout
            android:id="@+id/forgotPhoneTab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/circular_border_solid"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_rdc_flag" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:textStyle="bold"
                    android:text="+243"
                    android:layout_marginLeft="10dp"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/forgotPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/forgot_phone_hint"
                    android:textSize="14sp"
                    android:layout_marginLeft="10dp"
                    android:background="@null"
                    android:inputType="phone" />
            </LinearLayout>

            <Button
                android:id="@+id/forgotSendCodeBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/next"
                android:padding="16dp"
                android:text="@string/forgot_send_code"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- Étape 2 : code de vérification -->
        <LinearLayout
            android:id="@+id/forgotCodeTab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:background="@drawable/circular_border_solid"
                android:gravity="center"
                android:padding="18dp">

                <EditText
                    android:id="@+id/forgotCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="@string/forgot_code_hint"
                    android:inputType="number"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/forgotVerifyBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/next"
                android:padding="16dp"
                android:text="@string/forgot_verify"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- Étape 3 : nouveau mot de passe -->
        <LinearLayout
            android:id="@+id/forgotPasswordTab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:background="@drawable/circular_border_solid"
                android:gravity="center"
                android:padding="18dp">

                <EditText
                    android:id="@+id/forgotNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="@string/forgot_new_password_hint"
                    android:inputType="textPassword"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/forgotSavePasswordBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/next"
                android:padding="16dp"
                android:text="@string/forgot_save_password"
                android:textColor="@android:color/white" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
